FROM python:3.11-slim

WORKDIR /app

# build-essential + cmake are required to compile opencc from source on
# architectures with no prebuilt wheel (notably linux/arm64 on Apple Silicon).
# Prod uses Alpine with its own toolchain path, so this only affects dev.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        build-essential \
        cmake \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY backend/pyproject.toml /tmp/pyproject.toml
RUN uv pip install --system --no-cache -r /tmp/pyproject.toml --extra dev

RUN mkdir -p /app/module && echo "VERSION='DEV_VERSION'" > /app/module/__version__.py
RUN mkdir -p /app/config /app/data

EXPOSE 7893

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7893", "--reload"]
